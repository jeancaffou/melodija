{
  "name": "melodija",
  "version": "1.0.0",
  "description": "Electron/Quasar rewrite of the Melodija COBOL catalog.",
  "main": "app/electron/main.cjs",
  "scripts": {
    "migrate": "python3 tools/migrate.py",
    "dev": "node --no-turboshaft app/server/dev-server.cjs",
    "start:spa": "node app/server/spa-server.cjs",
    "build:renderer": "node --no-turboshaft ./node_modules/vite/bin/vite.js build",
    "build:renderer:docker": "node --no-opt --no-turboshaft ./node_modules/vite/bin/vite.js build",
    "electron:dev": "ELECTRON_RENDERER_URL=http://localhost:3333 electron .",
    "stage:db": "node tools/stage-companion-db.cjs",
    "dist:win": "npm run build:renderer && electron-builder --win portable --x64 && npm run stage:db"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.17",
    "@quasar/vite-plugin": "^1.10.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "electron-is-dev": "^3.0.1",
    "lucide-vue-next": "^0.468.0",
    "quasar": "^2.17.4",
    "sql.js": "^1.12.0",
    "vite": "^6.0.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "si.comfin.melodija",
    "productName": "Melodija",
    "asar": true,
    "files": [
      "app/**/*",
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release/build"
    },
    "artifactName": "Melodija.${ext}",
    "extraResources": [
      {
        "from": "melodija.db",
        "to": "melodija.db"
      }
    ],
    "win": {
      "icon": "app/electron/assets/melodija.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
