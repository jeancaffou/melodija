   729  procedure division.
   730  odpri.
   731          open i-o pesmi.
   732          move zero to pesmi-ownkey
   733          start pesmi key not < pesmi-ownkey invalid key
   734                  display "napaka-start"
   735                  go zapri.
   736  prenesi.
   737          READ PESMI NEXT RECORD
   738                  AT END GO ZAPRI.
   739
   740*         if pesmi-zbori = 4 go prenesi.
   741
   742          add 1 to citanih
   743          display "citanih " citanih
   744          move pesmi-opomba to opomba
   745
   746*         if opomba-7 = "ZA MLPZ"
   747*                 delete pesmi
   748*                 move 4 to pesmi-zbori
   749*                 move ostanek-1 to pesmi-opomba
   750*                 WRITE PESMI-AREA
   751*                 go prenesi.
   752
   753*         if opomba-4 = "MLPZ"
* Micro Focus VS COBOL V2.0.2        L2.0 revision 010 27-Mar-99 11:58 Page  14
