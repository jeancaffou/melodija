      *------------------ LHSEKR.LIB ----------------------------------
        SCREEN SECTION.
       copy okvlis40.ss.
        01  GLAVA-SCREEN.
                05 BLANK SCREEN
                        foreground-color 7
                        background-color 1.
                05 LINE 1 COLUMN 1  VALUE
                        "V i n k o                 "
                        BACKGROUND-COLOR 5
                        FOREGROUND-COLOR 2.
                05 LINE 1 COLUMN 19 VALUE
                "      N A S L O V I   P E S M I         "
                        HIGHLIGHT
                        BACKGROUND-COLOR 5
                        FOREGROUND-color 6.
                05 LINE 1 COLUMN 73 VALUE "SLO-2.3"
                        HIGHLIGHT
                        BACKGROUND-COLOR 5
                        FOREGROUND-color 2.
                05 LINE 2 COLUMN 1 PIC X(80) USING PROGRM
                        BACKGROUND-COLOR 5
                        FOREGROUND-color 2.
                05 LINE 2 COLUMN 21 PIC X(30) USING NASL
                        HIGHLIGHT
                        BACKGROUND-COLOR 5
                        FOREGROUND-color 2.
                05 LINE 2 COLUMN 62 VALUE " Datum: ".
                05 LINE 2 COLUMN 70 PIC 99 USING DD.
                05 LINE 2 COLUMN 72 VALUE ".".
                05 LINE 2 COLUMN 73 PIC 99 USING DM.
                05 LINE 2 COLUMN 75 VALUE ".19".
                05 LINE 2 COLUMN 78 PIC 99 USING DL.

                05  LINE 3 COLUMN 1 highlight
               VALUE "컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴
