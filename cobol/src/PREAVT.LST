   726  procedure division.
   727  odpri.
   728          open i-o pesmi.
   729          move zero to pesmi-ownkey
   730          start pesmi key not < pesmi-ownkey invalid key
   731                  display "napaka-start"
   732                  go zapri.
   733  prenesi.
   734          READ PESMI NEXT RECORD
   735                  AT END GO ZAPRI.
   736
   737          if pesmi-stevilka = zero
   738                  delete pesmi invalid key
   739                          display "napaka-delete".
   740
   741          if PESMI-PRIRED = 999999
   742                          move 329 to PESMI-PRIRED
   743                          display "999999"
   744          else
   745                  if PESMI-PRIRED = 99998
   746                          move 328 to PESMI-PRIRED
   747                          display "99998"
   748                  else
   749                          go prenesi.
   750
   751*         add 1 to citanih
   752*         display "citanih " citanih
   753*         move pesmi-opomba to opomba
