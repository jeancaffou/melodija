        01 DB-STAT          PIC X(2).
                88 STARS VALUE "00" "02" "04" "05" "07".
                88 MRNF VALUE "23".
                88 DUPM VALUE "22".
                88 ENDP VALUE "10".
                88 HELD VALUE "9A".
                88 POLN VALUE "24" "34" "44".
                88 FSER VALUE "21" "30" "35" "37" "38" "39"
                              "41" "42" "43" "46" "47" "48" "49".
