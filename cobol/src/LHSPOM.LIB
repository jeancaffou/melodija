        01 function-key-table.
           03 terminator pic 9(2) comp.
                88 RV-OK VALUE 0 4 10 13.
                88 RV-ENTER        VALUE 0.
                88 RV-potrditev    VALUE 1.
                88 RV-help         VALUE 2.
                88 RV-slika        VALUE 3.
                88 RV-nazaj        VALUE 4.
      *         88 RV-listaj       VALUE 5 6.
                88 RV-lissif       VALUE 5.
                88 RV-lisabc       VALUE 6.
      *         88 RV-printaj      VALUE 7 8.
                88 RV-izpsif       VALUE 7.
                88 RV-izpabc       VALUE 8.
                88 RV-rezer        VALUE 9.
                88 RV-brisi        VALUE 10.
                88 RV-ESC          VALUE 13.
            03  f1-sequence   pic X(3)    value X"02003B".
            03  f2-sequence   pic X(3)    value X"02003C".
            03  f3-sequence   pic X(3)    value X"02003D".
            03  f4-sequence   pic X(3)    value X"02003E".
            03  f5-sequence   pic X(3)    value X"02003F".
            03  f6-sequence   pic X(3)    value X"020040".
            03  f7-sequence   pic X(3)    value X"020041".
            03  f8-sequence   pic X(3)    value X"020042".
            03  f9-sequence   pic X(3)    value X"020043".
            03  f10-sequence  pic X(3)    value X"020044".
            03  f11-sequence  pic X(3)    value X"020045".
            03  f12-sequence  pic X(3)    value X"020046".
            03  esc-sequence  pic X(2)    value X"011B".
            03  key-table-terminator  pic X(1)    value X"00".
